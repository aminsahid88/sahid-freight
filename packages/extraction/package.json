{
  "name": "@tbo/extraction",
  "version": "0.1.0",
  "private": true,
  "description": "Extraction contract, prompts (Phase 1) and the fictional golden dataset for the AI Trucking Back-Office Platform.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
