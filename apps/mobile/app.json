{
  "expo": {
    "name": "Sahid Freight",
    "slug": "sahid-freight",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F44"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sahidfreight.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Sahid Freight uses the camera to photograph fuel receipts and other paperwork for your company's books.",
        "NSPhotoLibraryUsageDescription": "Sahid Freight lets you pick receipt photos already on your phone to send to your company's books."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0A1F44"
      },
      "package": "com.sahidfreight.app",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "VIBRATE"],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      ["expo-camera", { "cameraPermission": "Sahid Freight uses the camera to photograph fuel receipts and other paperwork." }],
      ["expo-image-picker", { "photosPermission": "Sahid Freight lets you pick receipt photos already on your phone." }]
    ],
    "scheme": "sahidfreight",
    "extra": {
      "eas": {
        "projectId": "f26aee53-6151-45ae-8bb5-edfa545373ff"
      }
    }
  }
}
