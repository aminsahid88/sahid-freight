{
  "expo": {
    "name": "Sahid Freight",
    "slug": "sahid-freight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030b05"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahidfreight.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sahid Freight uses your location to track deliveries and show your position to cargo senders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sahid Freight uses your location in the background to continuously track active deliveries.",
        "NSCameraUsageDescription": "Sahid Freight uses your camera to take photos of truck documents and cargo.",
        "NSPhotoLibraryUsageDescription": "Sahid Freight accesses your photos to upload truck registration and cargo documents.",
        "NSContactsUsageDescription": "Sahid Freight does not access your contacts.",
        "NSUserTrackingUsageDescription": "We use tracking to improve app performance and show relevant content."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030b05"
      },
      "package": "com.sahidfreight.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC5G5cQdrtKPRdMJnO1WR06WC0c_0iSJr0"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#030b05",
        "barStyle": "dark-content"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "./plugins/withDynamicFrameworks",
      "./plugins/withFirebaseAuthUrl"
    ],
    "scheme": "sahidfreight",
    "extra": {
      "eas": {
        "projectId": "f26aee53-6151-45ae-8bb5-edfa545373ff"
      }
    }
  }
}
