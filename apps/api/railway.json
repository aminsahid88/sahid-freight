{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev --no-audit --no-fund && npx prisma generate --schema=./prisma/schema.prisma"
  },
  "deploy": {
    "startCommand": "sh scripts/start.sh",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health"
  }
}
