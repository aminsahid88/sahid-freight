generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  CARGO_SENDER
  TRUCK_OWNER
  DRIVER
  ADMIN
}

enum UserStatus {
  DOCUMENTS_SUBMITTED
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SenderType {
  INDIVIDUAL
  PRIVATE_COMPANY
  STORE
  NGO
  UN_AGENCY
  GOVERNMENT
  BANK
  OTHER_ORGANIZATION
}

enum TruckType {
  FLATBED
  REFRIGERATED
  TANKER
  CONTAINER
  OPEN_BODY
  MINI_TRUCK
}

enum LoadStatus {
  DRAFT
  OPEN
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  // Ethiopia
  TELEBIRR
  CBE_BIRR
  AWASH_BANK
  DASHEN_BANK
  ABYSSINIA_BANK
  // Somalia
  HORMUUD_EVCPLUS
  PREMIER_BANK_SO
  SALAAM_BANK
  AMAL_BANK
  DAHABSHIIL
  // Djibouti
  BANK_OF_AFRICA_DJ
  BCIMR
  EXIM_BANK_DJ
  CAC_BANK_DJ
  SABA_BANK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CHAPA
  WAAFI
  CASH
}

enum Country {
  ETHIOPIA
  SOMALIA
  DJIBOUTI
}

enum Language {
  EN
  AM
  SO
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  PROFILE_PHOTO
  NATIONAL_ID
  DRIVERS_LICENSE
  TRUCK_REGISTRATION
  TRUCK_INSURANCE
  VEHICLE_INSPECTION
  PLATE_NUMBER_PHOTO
  TRADE_LICENSE
  TAX_IDENTIFICATION
  COMPANY_REGISTRATION
  AUTHORIZED_PERSON_ID
}

enum NotificationType {
  NEW_LOAD
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  LOAD_PICKED_UP
  LOAD_DELIVERED
  PAYMENT_RECEIVED
  NEW_REVIEW
  ACCOUNT_VERIFIED
  NEW_BID
  BID_ACCEPTED
  BID_REJECTED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id                String      @id @default(uuid())
  fullName          String
  email             String?     @unique
  phone             String      @unique
  passwordHash      String?
  firebaseUid       String?     @unique
  phoneVerified     Boolean     @default(false)
  googleId          String?     @unique
  appleId           String?     @unique
  pushToken         String?
  role              UserRole
  status            UserStatus  @default(PENDING_VERIFICATION)
  country           Country     @default(ETHIOPIA)
  city              String      @default("")
  preferredLanguage Language    @default(EN)
  profilePhoto      String?
  licenseNumber     String?
  isVerified        Boolean     @default(false)
  averageRating     Float?
  totalRatings      Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  trucks            Truck[]
  drivenTrucks      Truck[]            @relation("TruckDriver")
  loadsPosted       Load[]
  bookingsAsSender  Booking[]          @relation("SenderBookings")
  bookingsAsOwner   Booking[]          @relation("OwnerBookings")
  bookingsAsDriver  Booking[]          @relation("DriverBookings")
  invitedById       String?
  invitedBy         User?              @relation("DriverInvites", fields: [invitedById], references: [id])
  drivers           User[]             @relation("DriverInvites")
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
  bidsPlaced        Bid[]              @relation("BidsAsOwner")
  notifications     Notification[]
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  payments          Payment[]
  refreshTokens     RefreshToken[]
  senderProfile     SenderProfile?
  truckOwnerProfile TruckOwnerProfile?
}

// ─────────────────────────────────────────
// REFRESH TOKENS
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// TRUCK
// ─────────────────────────────────────────

model Truck {
  id             String    @id @default(uuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id])
  plateNumber    String    @unique
  truckType      TruckType
  capacityTons   Float
  lengthMeters   Float?
  photoUrl       String?
  isAvailable    Boolean   @default(true)
  isVerified     Boolean   @default(false)
  currentCity    String
  currentCountry Country
  driverId       String?
  driver         User?     @relation("TruckDriver", fields: [driverId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings       Booking[]
  locations      TruckLocation[]
  bids           Bid[]
}

// ─────────────────────────────────────────
// LOAD
// ─────────────────────────────────────────

model Load {
  id              String     @id @default(uuid())
  senderId        String
  sender          User       @relation(fields: [senderId], references: [id])
  title           String
  description     String?
  weightTons      Float
  truckTypeNeeded TruckType
  pickupCity      String
  pickupCountry   Country
  pickupLat       Float?
  pickupLng       Float?
  deliveryCity    String
  deliveryCountry Country
  deliveryLat     Float?
  deliveryLng     Float?
  offeredPrice    Float
  currency        String     @default("USD")
  status          LoadStatus @default(OPEN)
  scheduledDate   DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bookings        Booking[]
  bids            Bid[]
}

// ─────────────────────────────────────────
// BID
// ─────────────────────────────────────────

model Bid {
  id           String    @id @default(uuid())
  loadId       String
  load         Load      @relation(fields: [loadId], references: [id])
  truckOwnerId String
  truckOwner   User      @relation("BidsAsOwner", fields: [truckOwnerId], references: [id])
  truckId      String?
  truck        Truck?    @relation(fields: [truckId], references: [id])
  price        Float
  currency     String    @default("USD")
  message      String?
  status       BidStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────

model Booking {
  id          String        @id @default(uuid())
  loadId      String
  load        Load          @relation(fields: [loadId], references: [id])
  truckId     String
  truck       Truck         @relation(fields: [truckId], references: [id])
  senderId    String
  sender      User          @relation("SenderBookings", fields: [senderId], references: [id])
  ownerId     String
  owner       User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  driverId    String?
  driver      User?         @relation("DriverBookings", fields: [driverId], references: [id])
  status      BookingStatus @default(PENDING)
  agreedPrice Float
  currency    String        @default("USD")
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  senderRating    Int?
  ownerRating     Int?
  senderComment   String?
  ownerComment    String?
  senderRatedAt   DateTime?
  ownerRatedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment     Payment?
  review      Review?
  messages Message[]
}

// ─────────────────────────────────────────
// LIVE TRUCK LOCATION TRACKING
// ─────────────────────────────────────────

model TruckLocation {
  id         String   @id @default(uuid())
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  recordedAt DateTime @default(now())
}

// ─────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────

model Payment {
  id              String          @id @default(uuid())
  bookingId       String          @unique
  booking         Booking         @relation(fields: [bookingId], references: [id])
  payerId         String
  payer           User            @relation(fields: [payerId], references: [id])
  amount          Float
  currency        String          @default("USD")
  method          PaymentMethod?
  provider        PaymentProvider @default(CASH)
  status          PaymentStatus   @default(PENDING)
  transactionRef  String?
  providerRef     String?
  providerStatus  String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ─────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// ─────────────────────────────────────────
// SENDER PROFILE
// ─────────────────────────────────────────

model SenderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  senderType         SenderType
  nationalIdNumber   String?
  organizationName   String?
  tinNumber          String?
  tradeLicenseNumber String?
  authorizedPerson   String?
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents          VerificationDocument[]
}

// ─────────────────────────────────────────
// TRUCK OWNER PROFILE
// ─────────────────────────────────────────

model TruckOwnerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  licenseNumber      String?
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents          VerificationDocument[]
}

// ─────────────────────────────────────────
// VERIFICATION DOCUMENTS (stored in MinIO)
// ─────────────────────────────────────────

model VerificationDocument {
  id                  String             @id @default(uuid())
  documentType        DocumentType
  fileUrl             String
  fileName            String
  fileSize            Int
  mimeType            String
  uploadedAt          DateTime           @default(now())

  senderProfileId     String?
  senderProfile       SenderProfile?     @relation(fields: [senderProfileId], references: [id])
  truckOwnerProfileId String?
  truckOwnerProfile   TruckOwnerProfile? @relation(fields: [truckOwnerProfileId], references: [id])
}

// ─────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────

model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  bookingId   String?
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
}