# ─────────────────────────────────────────────────────────────────────────────
#  Sahid Freight API — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
#  This file is the source of truth for which env vars the API expects.
#  Copy it to either:
#    .env       → loaded by `npm run dev` and production (Railway)
#    .env.local → loaded by the *:local scripts (db:migrate:local, dev:local…)
#                 and used to point at the docker-compose Postgres
#  Both files are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. For local dev with the bundled docker-compose:
#   postgresql://loadlink_admin:LoadLink%402025%23Secure@localhost:5432/loadlink_db?schema=public
# For Railway prod: paste the value from the Railway Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=8000
# Public base URL the API serves on (used to build payment callback URLs).
API_URL="http://localhost:8000"
# Comma-separated allowlist of browser Origins. Required — Express CORS and
# Socket.io CORS reject everything else. Include every web URL you'll open.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── JWT ─────────────────────────────────────────────────────────────────────
# Use long random strings in prod. Local dev can use any value.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# ── Webhooks ────────────────────────────────────────────────────────────────
# HMAC SHA-256 shared secret with Chapa, configured on their merchant dashboard.
# The /payments/webhook/chapa endpoint rejects any request whose Chapa-Signature
# header does not match HMAC(secret, raw_body). Required.
CHAPA_WEBHOOK_SECRET="set-this-from-chapa-dashboard"

# ── Payment providers ───────────────────────────────────────────────────────
# Chapa (Ethiopia card / mobile money).
CHAPA_SECRET_KEY=""
# Waafi (Somalia EVC Plus / ZAAD).
WAAFI_MERCHANT_UID=""
WAAFI_API_USER_ID=""
WAAFI_API_KEY=""

# ── SMS (Africa's Talking) ──────────────────────────────────────────────────
# Used for bid-accepted/rejected SMS + driver invites. Optional in dev.
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Firebase Admin (phone OTP) ──────────────────────────────────────────────
# Required for phone-OTP login flows. If unset, the API boots with the warning
# "Firebase Admin credentials missing — phone verification will not work".
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the service-account private key. Keep \n line breaks literal.
FIREBASE_PRIVATE_KEY=""

# ── Social login ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
APPLE_BUNDLE_ID="com.sahidfreight.app"

# ── File storage ────────────────────────────────────────────────────────────
# AWS S3 — primary in prod.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# MinIO — fallback for self-hosted / local. The docker-compose minio service
# (root docker-compose.yml) listens on localhost:9000 with the credentials below.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_BUCKET="sahidfreightdocuments"
MINIO_ACCESS_KEY="loadlink_admin"
MINIO_SECRET_KEY="LoadLink@2025#Secure"
