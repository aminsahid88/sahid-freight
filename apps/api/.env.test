# Test environment — local Docker Postgres only (docker compose up -d postgres).
# No secrets here; values are throwaway and the DB is disposable.
NODE_ENV=test
DATABASE_URL="postgresql://loadlink_admin:LoadLink%402025%23Secure@localhost:5432/loadlink_test?schema=public"
JWT_SECRET="test-jwt-secret-test-jwt-secret-test-jwt-secret"
JWT_REFRESH_SECRET="test-refresh-secret-test-refresh-secret-xx"
ALLOWED_ORIGINS="http://localhost:3000"
PORT=8000
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=".storage-test"
API_URL="http://localhost:8000"
