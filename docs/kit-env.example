# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://user:pass@localhost:5432/trucking_backoffice
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
FIELD_ENCRYPTION_KEY=32-byte-base64-key

# --- Object storage (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- AI extraction (verify model IDs against current Anthropic docs) ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL_A=
EXTRACTION_MODEL_B=
EXTRACTION_PROMPT_VERSION_A=a-v1
EXTRACTION_PROMPT_VERSION_B=b-v1
AI_MONTHLY_BUDGET_USD=50

# --- Messaging ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_WEBHOOK_SECRET=
OUTBOUND_EMAIL_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Business rules ---
RETENTION_YEARS=4
MPG_BAND_MIN=4.0
MPG_BAND_MAX=9.0
