// Draft schema — AI Trucking Back-Office Platform (Phase 0/1)
// Money: Decimal(12,2). Gallons/miles: Decimal(12,3). Every tenant table has companyId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  DRIVER
  REVIEWER
  PARTNER
  ADMIN
}
enum Language {
  en
  so
}
enum Channel {
  WEB
  PWA
  EMAIL
  SMS
  WHATSAPP
  FUEL_CARD_IMPORT
  ELD_IMPORT
}
enum PeriodType {
  MONTH
  QUARTER
  YEAR
}
enum PeriodStatus {
  OPEN
  IN_REVIEW
  APPROVED
  LOCKED
}
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}
enum TxStatus {
  VERIFIED
  NEEDS_ATTENTION
  UNABLE_TO_VERIFY
}
enum TxType {
  FUEL
  EXPENSE
  REFUND
  CREDIT
  OTHER
  UNKNOWN
}
enum LineCategory {
  MOTOR_FUEL
  REEFER_FUEL
  DEF
  NON_FUEL
  TAX
  FEE
  DISCOUNT
  CREDIT
}
enum Corroboration {
  SINGLE_SOURCE
  TWO_PASS
  RECEIPT_AND_CARD
  HUMAN_CONFIRMED
}
enum Severity {
  ERROR
  WARNING
  INFO
}
enum IssueStatus {
  OPEN
  RESOLVED
  ACCEPTED
}
enum Legibility {
  CLEAR
  PARTIAL
  UNREADABLE
}
enum ReportType {
  PERIOD_PDF
  TRANSACTIONS_CSV
  SUPPORT_ZIP
  IFTA_WORKSHEET
}
enum ReportStatus {
  PRELIMINARY
  REVIEWED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  isPartner Boolean   @default(false)
  companies Company[]
  createdAt DateTime  @default(now())
}

model Company {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  legalName         String
  dba               String?
  usdot             String?
  mcNumber          String?
  iftaBaseJurisdiction String?
  iftaAccountEnc    String?  // field-level encrypted
  language          Language @default(en)
  timezone          String   @default("America/New_York")
  inboundEmailSlug  String   @unique
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())

  memberships  Membership[]
  vehicles     Vehicle[]
  drivers      Driver[]
  periods      ReportingPeriod[]
  documents    Document[]
  batches      Batch[]
  transactions Transaction[]
  issues       Issue[]
  reports      Report[]
  fuelCardImports FuelCardImport[]
  mileageImports  MileageImport[]
  auditLogs    AuditLog[]
  settings     Setting[]
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String
  language  Language @default(en)
  createdAt DateTime @default(now())
  memberships Membership[]
}

model Membership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  role      Role
  user      User    @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  @@unique([userId, companyId, role])
  @@index([companyId])
}

model Vehicle {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  unitNumber    String
  vin           String?
  plate         String?
  axles         Int?
  iftaQualified Boolean  @default(true)
  tankCapacityGal Decimal? @db.Decimal(12,3)
  eldProvider   String?
  activeFrom    DateTime?
  activeTo      DateTime?
  drivers       Driver[]
  transactions  Transaction[]
  mileage       MileageRecord[]
  @@unique([companyId, unitNumber])
}

model Driver {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  phone            String?
  defaultVehicleId String?
  defaultVehicle   Vehicle? @relation(fields: [defaultVehicleId], references: [id])
  active           Boolean  @default(true)
  @@index([companyId])
}

model ReportingPeriod {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  type      PeriodType
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)
  transactions Transaction[]
  reports   Report[]
  @@unique([companyId, type, startDate])
}

model IntakeMessage {
  id         String   @id @default(cuid())
  companyId  String?  // null until attributed
  channel    Channel
  sender     String
  rawEnvelope Json
  attribution String  // matched | unassigned | rejected
  receivedAt DateTime @default(now())
  documents  Document[]
}

model Batch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdBy String
  status    JobStatus @default(QUEUED)
  createdAt DateTime @default(now())
  documents Document[]
}

model Document {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  batchId        String?
  batch          Batch?   @relation(fields: [batchId], references: [id])
  intakeMessageId String?
  intakeMessage  IntakeMessage? @relation(fields: [intakeMessageId], references: [id])
  channel        Channel
  uploadedBy     String?
  storageKey     String   // immutable original
  filename       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  qualityScore   Decimal? @db.Decimal(4,3)
  receivedAt     DateTime @default(now())
  retentionUntil DateTime
  regions        DocumentRegion[]
  @@index([companyId, sha256])
}

model DocumentRegion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  page       Int
  bbox       Json?
  runs       ExtractionRun[]
  transaction Transaction?
}

model ExtractionRun {
  id            String   @id @default(cuid())
  regionId      String
  region        DocumentRegion @relation(fields: [regionId], references: [id])
  pass          String   // "A" | "B"
  modelId       String
  promptVersion String
  rawResponse   Json
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Decimal? @db.Decimal(10,5)
  latencyMs     Int?
  status        JobStatus
  createdAt     DateTime @default(now())
  fields        ExtractedField[]
  @@unique([regionId, pass, modelId, promptVersion])
}

model ExtractedField {
  id         String     @id @default(cuid())
  runId      String
  run        ExtractionRun @relation(fields: [runId], references: [id])
  name       String
  rawText    String?
  value      String?    // normalized, stored as string; typed in domain layer
  confidence Decimal?   @db.Decimal(4,3)
  legibility Legibility
  bbox       Json?
}

model Transaction {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  periodId        String?
  period          ReportingPeriod? @relation(fields: [periodId], references: [id])
  regionId        String?  @unique
  region          DocumentRegion? @relation(fields: [regionId], references: [id])
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId        String?
  type            TxType   @default(UNKNOWN)
  date            DateTime? @db.Date
  time            String?
  vendor          String?
  sellerAddress   String?
  state           String?
  stateSource     String?  // printed | lookup | user
  unitNumberRaw   String?
  odometer        Decimal? @db.Decimal(12,1)
  paymentMethod   String?
  cardLast4       String?
  receiptTotal    Decimal? @db.Decimal(12,2)
  currency        String?  @default("USD")
  iftaTaxableGallons Decimal? @db.Decimal(12,3) // computed by code: motor fuel only
  status          TxStatus @default(NEEDS_ATTENTION)
  corroboration   Corroboration @default(SINGLE_SOURCE)
  provenance      Json     // field -> {passA, passB, final, finalSource, bbox}
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime @default(now())
  lines           TransactionLine[]
  issues          Issue[]
  matches         Match[]
  @@index([companyId, date])
  @@index([companyId, state])
}

model TransactionLine {
  id             String       @id @default(cuid())
  transactionId  String
  transaction    Transaction  @relation(fields: [transactionId], references: [id])
  descriptionRaw String
  category       LineCategory
  fuelType       String?
  quantity       Decimal?     @db.Decimal(12,3)
  unit           String?
  unitPrice      Decimal?     @db.Decimal(12,4)
  amount         Decimal?     @db.Decimal(12,2)
}

model FuelCardImport {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  provider       String   // comdata | wex_efs | atob | tcs | generic
  mappingVersion String
  documentId     String?
  importedAt     DateTime @default(now())
  rows           FuelCardTransaction[]
}

model FuelCardTransaction {
  id         String   @id @default(cuid())
  importId   String
  import     FuelCardImport @relation(fields: [importId], references: [id])
  companyId  String
  date       DateTime @db.Date
  location   String?
  state      String?
  unitNumber String?
  cardLast4  String?
  fuelType   String?
  gallons    Decimal? @db.Decimal(12,3)
  amount     Decimal? @db.Decimal(12,2)
  raw        Json
  matches    Match[]
  @@index([companyId, date])
}

model MileageImport {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  provider   String
  documentId String?
  importedAt DateTime @default(now())
  records    MileageRecord[]
}

model MileageRecord {
  id            String   @id @default(cuid())
  importId      String
  import        MileageImport @relation(fields: [importId], references: [id])
  companyId     String
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  jurisdiction  String
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  totalMiles    Decimal  @db.Decimal(12,3)
  taxableMiles  Decimal  @db.Decimal(12,3)
  @@index([companyId, vehicleId, periodStart])
}

model Match {
  id                String   @id @default(cuid())
  transactionId     String
  transaction       Transaction @relation(fields: [transactionId], references: [id])
  cardTransactionId String
  cardTransaction   FuelCardTransaction @relation(fields: [cardTransactionId], references: [id])
  score             Decimal  @db.Decimal(4,3)
  fieldsUsed        Json
  ruleVersion       String
  @@unique([transactionId, cardTransactionId])
}

model Issue {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  code          String      // e.g. F001
  ruleVersion   String
  severity      Severity
  message       String
  fields        String[]
  evidence      Json
  status        IssueStatus @default(OPEN)
  resolvedBy    String?
  resolutionNote String?
  createdAt     DateTime    @default(now())
  @@index([companyId, status])
}

model FieldEdit {
  id         String   @id @default(cuid())
  companyId  String
  entity     String   // Transaction | TransactionLine | ...
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  reason     String
  evidence   Json?
  userId     String
  createdAt  DateTime @default(now())
  @@index([companyId, entity, entityId])
}

model Approval {
  id        String   @id @default(cuid())
  companyId String
  target    String   // correction | period | report
  targetId  String
  userId    String
  createdAt DateTime @default(now())
}

model Jurisdiction {
  code       String  @id // e.g. OH, ON
  name       String
  country    String  // US | CA
  iftaMember Boolean @default(true)
}

model IftaRate {
  id           String  @id @default(cuid())
  quarter      String  // e.g. 2026Q4
  jurisdiction String
  fuelType     String
  rate         Decimal @db.Decimal(10,5)
  surcharge    Decimal? @db.Decimal(10,5)
  sourceUrl    String
  importedAt   DateTime @default(now())
  @@unique([quarter, jurisdiction, fuelType])
}

model StationDirectory {
  id      String @id @default(cuid())
  brand   String
  storeNo String?
  address String
  city    String
  state   String
  @@index([brand, storeNo])
}

model Report {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  periodId     String
  period       ReportingPeriod @relation(fields: [periodId], references: [id])
  type         ReportType
  status       ReportStatus
  snapshotHash String
  fileKey      String
  generatedBy  String
  createdAt    DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?
  action    String   // login | upload | view_document | edit | approve | export | delete_request | break_glass
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}

model Job {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique // documentId:step:version
  step           String
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  error          String?
  updatedAt      DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  key       String
  value     Json
  @@unique([companyId, key])
}
