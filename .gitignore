node_modules/
.next/
.env
.env.local
*.env
dist/
build/
.DS_Store
.vercel

# Expo local state (devices.json, prebuild cache, web image cache)
.expo/

# Firebase Admin SDK service account — must be loaded from env, never committed
apps/api/src/utils/firebase-service-account.json

# Pre-brandpack asset backups — kept locally, not tracked
apps/mobile/assets/_backup_pre_brandpack/
apps/web/public/_backup_pre_brandpack/

# Local storage driver (dev/test uploads)
apps/api/.storage/
apps/api/.storage-test/

# How-to-use video is built locally (docs/how-to-use/tooling); the rendered file is too large for git
docs/how-to-use/*.mp4
